# ELA Lab — environment variables
#
# The application requires NONE of these to run or deploy. It is self-contained:
# no database, no API keys, no external services. Copy this file to `.env.local`
# only if you want to regenerate the catalog with different parameters.
#
# These are read by the offline seed job (`npm run seed`) in scripts/seed.ts.

# Seed for the deterministic world generator. The same seed always produces the
# same robots, episodes, anomalies and quality scores.
# SEED=omakase-ela-lab-2026

# How many episodes to simulate into data/catalog.json.
# Roughly 6 KB of committed JSON and ~30 ms of build time per episode.
# EPISODE_COUNT=180

# End of the 45-day collection window. Fixed by default so the committed catalog
# is stable across regenerations rather than drifting with the current date.
# WINDOW_END=2026-08-15T09:00:00Z
